{
  "version": 2,
  "name": "ieee-blockchain-pune-section",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(css|js|assets|data)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/about", "dest": "/about.html" },
    { "src": "/committee", "dest": "/committee.html" },
    { "src": "/tracks", "dest": "/tracks.html" },
    { "src": "/events", "dest": "/events.html" },
    { "src": "/speakers", "dest": "/speakers.html" },
    { "src": "/membership", "dest": "/membership.html" },
    { "src": "/venue", "dest": "/venue.html" },
    { "src": "/contact", "dest": "/contact.html" },
    { "src": "/chapters", "dest": "/chapters.html" },
    { "src": "/education", "dest": "/education.html" },
    { "src": "/resources", "dest": "/resources.html" },
    { "src": "/standards", "dest": "/standards.html" },
    { "src": "/proceedings", "dest": "/proceedings.html" },
    { "src": "/india-ecosystem", "dest": "/india-ecosystem.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
